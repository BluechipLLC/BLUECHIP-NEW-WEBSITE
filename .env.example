# Server only, except NEXT_PUBLIC_* values. Copy to .env.local for local development;
# set the same variables in the host's secret settings for production.

# Public URL used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://bluechipbranding.net

# Cal.com consultation booking (see README).
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_WEBHOOK_SECRET=

# Resend inquiry notifications (see README).
RESEND_API_KEY=
BLUECHIP_INQUIRY_FROM=
BLUECHIP_INQUIRY_TO=info@bluechipbranding.net

# Point production at a private, persistent, backed-up volume outside public/.
BLUECHIP_INQUIRY_DIR=./data/inquiries

# Number of reverse proxies in front of the app (used to find the visitor's address for rate limiting).
TRUST_PROXY=1
